<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Dashboard Financeiro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%# Partials em .css/.js e não .html: em desenvolvimento o Rails anota cada
        partial HTML com <!-- BEGIN ... -->, e dentro de <script> o <!-- inicia
        um comentário de linha, o que comentaria a primeira linha do código. %>
    <style nonce="<%= content_security_policy_nonce %>">
<%= raw render(partial: "styles", formats: [ :css ]) %>
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="navbar-brand">Dashboard Financeiro</div>
        <div class="user-info">
            <span id="userEmailDisplay" class="user-email">Carregando...</span>
            <button data-action="logout" class="btn-logout">Sair</button>
        </div>
    </nav>

    <main class="main-content">
        <div class="dashboard-header">
            <h1>Painel Principal</h1>
            <p>Resumo financeiro e carteiras carregadas em tempo real via GraphQL.</p>
            <div class="actions-bar">
                <button class="btn-income" data-action="open-create" data-kind="income">+ Nova Receita</button>
                <button class="btn-expense" data-action="open-create" data-kind="expense">+ Nova Despesa</button>
            </div>
        </div>

        <div id="pageAlert" class="alert-message"></div>

        <div class="card-grid">
            <div class="card balance">
                <h3>Saldo Geral Total</h3>
                <div id="balanceValue" class="value">R$ --</div>
            </div>

            <div class="card income">
                <h3>Receitas Totais</h3>
                <div id="incomeValue" class="value">R$ --</div>
            </div>

            <div class="card expense">
                <h3>Despesas Totais</h3>
                <div id="expenseValue" class="value">R$ --</div>
            </div>
        </div>

        <h2 class="section-title">Minhas Carteiras</h2>
        <div id="walletsGrid" class="card-grid">
            <div class="card wallet-card">
                <div class="wallet-name">Carregando...</div>
                <div class="wallet-balance">R$ 0,00</div>
            </div>
        </div>

        <div class="section-header">
            <h2 class="section-title">Receitas</h2>
            <button class="btn-income" data-action="open-create" data-kind="income">+ Nova Receita</button>
        </div>
        <div id="incomesList" class="entry-list">
            <div class="empty-state">Carregando...</div>
        </div>

        <div class="section-header">
            <h2 class="section-title">Despesas</h2>
            <button class="btn-expense" data-action="open-create" data-kind="expense">+ Nova Despesa</button>
        </div>
        <div id="expensesList" class="entry-list">
            <div class="empty-state">Carregando...</div>
        </div>

        <div class="section-header">
            <h2 class="section-title">Lançamentos Recorrentes</h2>
        </div>
        <div id="recurringList" class="entry-list">
            <div class="empty-state">Carregando...</div>
        </div>
    </main>

    <%= render "entry_modal" %>

    <script nonce="<%= content_security_policy_nonce %>">
<%= raw render(partial: "scripts", formats: [ :js ]) %>
    </script>
</body>
</html>
