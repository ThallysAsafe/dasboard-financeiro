<div id="entryModal" class="modal-overlay">
    <div class="modal">
        <div class="modal-header">
            <h2 id="modalTitle">Nova Receita</h2>
            <button type="button" class="modal-close" data-action="close-modal" aria-label="Fechar">&times;</button>
        </div>

        <div id="modalAlert" class="alert-message"></div>

        <form id="entryForm">
            <div class="form-group">
                <label for="entryDescription">Descrição</label>
                <input type="text" id="entryDescription" placeholder="Ex.: Salário" required>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="entryAmount">Valor (R$)</label>
                    <input type="number" id="entryAmount" step="0.01" min="0.01" placeholder="0,00" required>
                </div>

                <div class="form-group">
                    <label for="entryDate" id="entryDateLabel">Data</label>
                    <input type="date" id="entryDate" required>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="entryCategory">Categoria (opcional)</label>
                    <input type="text" id="entryCategory" placeholder="Ex.: Trabalho">
                </div>
            </div>

            <div class="form-check">
                <input type="checkbox" id="entryRecurring">
                <label for="entryRecurring">Repetir todo mês</label>
            </div>

            <div id="recurringFields" style="display: none;">
                <div class="form-row">
                    <div class="form-group">
                        <label for="entryDayOfMonth">Dia do mês</label>
                        <input type="number" id="entryDayOfMonth" min="1" max="31">
                    </div>

                    <div class="form-group">
                        <label for="entryEndDate">Repetir até (opcional)</label>
                        <input type="date" id="entryEndDate">
                    </div>
                </div>

                <p class="field-hint">
                    Em meses sem o dia escolhido, o lançamento cai no último dia do mês.
                    Lançamentos anteriores à data de hoje são criados automaticamente.
                </p>

                <div class="form-check" id="entryActiveWrapper" style="display: none;">
                    <input type="checkbox" id="entryActive" checked>
                    <label for="entryActive">Recorrência ativa</label>
                </div>
            </div>

            <button type="submit" id="entrySubmit" class="btn-primary">Salvar</button>
        </form>
    </div>
</div>
