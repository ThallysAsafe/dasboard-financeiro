<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Dashboard Financeiro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "login" %>
</head>
<body>
    <div class="login-container">
        <div class="login-header">
            <h1>Bem-vindo</h1>
            <p>Faça login para acessar o dashboard</p>
        </div>

        <div id="alertMessage" class="alert-message"></div>

        <form id="loginForm">
            <div class="form-group">
                <label for="email">Email</label>
                <div class="input-wrapper">
                    <input 
                        type="email" 
                        id="email" 
                        name="email" 
                        placeholder="seu@email.com" 
                        required
                    >
                </div>
            </div>

            <div class="form-group">
                <label for="password">Senha</label>
                <div class="input-wrapper">
                    <input 
                        type="password" 
                        id="password" 
                        name="password" 
                        placeholder="Digite sua senha" 
                        required
                    >
                </div>
            </div>

            <div class="forgot-password">
                <a href="/password/forgot">Esqueceu sua senha?</a>
            </div>

            <button type="submit" id="btnSubmit" class="btn-login">Entrar</button>
        </form>

        <div class="divider">
            <span>ou</span>
        </div>

        <div class="signup-link">
            Não tem uma conta? <a href="/signup">Cadastre-se</a>
        </div>
    </div>

    <%= javascript_importmap_tags "login" %>
</body>
</html>
