# Copie para .env (que é ignorado pelo git) e preencha:  cp .env.example .env
# O docker-compose lê estas variáveis para criar o Postgres e conectar o app.

POSTGRES_USER=
POSTGRES_PASSWORD=

# Só em produção:
# RAILS_MASTER_KEY=   (conteúdo de config/master.key)
# APP_DATABASE_PASSWORD=

# E-mail (recuperar senha, confirmar e-mail). Em desenvolvimento não precisa de nada:
# o docker-compose já sobe o Mailpit e aponta o app para ele (http://localhost:8025).
# Em produção, qualquer provedor SMTP serve:
# SMTP_ADDRESS=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Dashboard Financeiro <nao-responda@seudominio.com>"
# APP_HOST=seudominio.com
